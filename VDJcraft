def add_count_column(df, sort_by_count=True):
    cols = ['v_gene', 'd_gene', 'j_gene', 'c_gene', 'cdr_sequence', 'aa_sequence', 'Query']
    
    grouped = df.groupby(cols).size().reset_index(name='count')
    
    
    reordered_cols = ['count'] + [col for col in cols if col != 'Query'] + ['Query']
    grouped = grouped[reordered_cols]
    
    
    if sort_by_count:
        grouped = grouped.sort_values(by='count', ascending=False).reset_index(drop=True)
    
    return grouped



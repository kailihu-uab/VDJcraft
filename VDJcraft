#Add function for potential novel events for Somatic hypermutation.
def SHM_event(df, sort_by_count=True):
    cols = ['Gene', 'queryseq']

    grouped = df.groupby(cols).size().reset_index(name='count')

    reordered_cols = ['count'] + cols
    grouped = grouped[reordered_cols]

    if sort_by_count:
        grouped = grouped.sort_values(by='count', ascending=False).reset_index(drop=True)

    return grouped



